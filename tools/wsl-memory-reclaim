#!/usr/bin/env bash

# WSL 主动内存回收：构建期间暂停，空闲时逐步回收文件缓存。
readonly CGROUP_PATH=/sys/fs/cgroup
readonly MEMORY_STAT="$CGROUP_PATH/memory.stat"
readonly MEMORY_RECLAIM="$CGROUP_PATH/memory.reclaim"
readonly LOG_FILE=/var/log/wsl-memory-reclaim.log
readonly TARGET_BYTES=$((2 * 1024 * 1024 * 1024))
readonly TRIGGER_BYTES=$((8 * 1024 * 1024 * 1024))
readonly INTERVAL_SECONDS=600

log_message() {
    printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG_FILE"
}

file_cache_bytes() {
    awk '$1 == "file" { print $2; exit }' "$MEMORY_STAT"
}

build_is_running() {
    local pid command

    pgrep -f '/build\.sh( |$)|/build/hb/|(^|[ /])hb( |$).*build' >/dev/null && return 0
    while read -r pid; do
        [ -n "$pid" ] || continue
        command="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)"
        case "$command" in
            *' -t '*) ;;
            *) return 0 ;;
        esac
    done < <(pgrep -x ninja; pgrep -x ninja_wrapper)

    return 1
}

reclaim_once() {
    local before reclaim_bytes after reclaimed

    build_is_running && return 0
    before="$(file_cache_bytes)"
    [ -n "$before" ] || return 1
    [ "$before" -gt "$TRIGGER_BYTES" ] || return 0

    reclaim_bytes=$((before - TARGET_BYTES))
    printf '%s\n' "$reclaim_bytes" > "$MEMORY_RECLAIM" 2>/dev/null
    after="$(file_cache_bytes)"
    reclaimed=$((before - after))
    [ "$reclaimed" -lt 0 ] && reclaimed=0
    log_message "文件缓存 $((before / 1024 / 1024)) MiB，申请回收 $((reclaim_bytes / 1024 / 1024)) MiB，实际减少 $((reclaimed / 1024 / 1024)) MiB"
}

if [ "${1:-}" = --once ]; then
    reclaim_once
    exit $?
fi

if [ -r /run/wsl-memory-reclaim.pid ] && kill -0 "$(cat /run/wsl-memory-reclaim.pid)" 2>/dev/null; then
    exit 0
fi
printf '%s\n' "$$" > /run/wsl-memory-reclaim.pid
trap 'exit 0' INT TERM
trap 'rm -f /run/wsl-memory-reclaim.pid' EXIT

log_message "服务启动：每 10 分钟检查，缓存超过 8 GiB 时回收到约 2 GiB；构建期间暂停"
while true; do
    reclaim_once
    sleep "$INTERVAL_SECONDS"
done
